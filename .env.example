# Copy to .env and adjust. Validated at startup (src/config/env.ts).

NODE_ENV=development
PORT=4000

# --- Database -----------------------------------------------------------------
# docker compose reads these to create the Postgres container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Host port for Postgres (connect with psql / Prisma Studio / a GUI from your machine).
DB_PORT=5432
# Used when running the API outside Docker (`npm run start:dev`).
# Inside docker compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# --- Redis (cache, shared rate limits, background jobs) --------------------------
# Used when running the API outside Docker. Inside docker compose this points at the `redis` service.
REDIS_URL=redis://localhost:6379
# Host port for Redis (redis-cli / GUI tools from your machine).
REDIS_PORT=6379
# Default cache TTL (seconds).
CACHE_TTL=300

# --- Email links ----------------------------------------------------------------
# Public URL of the frontend; verification / password-reset emails link here.
APP_URL=http://localhost:3000
# Link lifetimes (seconds).
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=3600

# --- Auth ---------------------------------------------------------------------
# At least 32 chars. Generate one with: openssl rand -base64 48
# (Production refuses to start with this example value or a weak DB password.)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access token lifetime (seconds). The frontend's access cookie follows `expiresIn`.
JWT_ACCESS_TTL=900
# Refresh token lifetime (seconds). 30 days, same as the frontend's refresh cookie.
REFRESH_TOKEN_TTL=2592000
# Seconds a just-rotated refresh token is still accepted (concurrent refreshes). 0 = strict.
REFRESH_REUSE_GRACE=10

# Google sign-in: the same client ID as base-frontend's GOOGLE_CLIENT_ID.
# Comma-separate several IDs (e.g. web + mobile). Empty = /auth/google returns 503.
GOOGLE_CLIENT_ID=

# --- HTTP ---------------------------------------------------------------------
# base-frontend calls the API server-to-server, so CORS is off by default.
# Set browser origins here only if a browser calls the API directly.
CORS_ORIGINS=
# Who may set X-Forwarded-For (the real client IP used by rate limits and logs):
# a hop count, or addresses/subnets/keywords. The default trusts private networks,
# where base-frontend and load balancers live; internet clients can't spoof it.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Rate limits per THROTTLE_TTL seconds:
#   THROTTLE_LIMIT          every route, per client IP
#   AUTH_THROTTLE_LIMIT     login/register/forgot-password, per email (all IPs)
#   AUTH_IP_THROTTLE_LIMIT  login/register/forgot-password, per client IP (all emails)
THROTTLE_TTL=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10
AUTH_IP_THROTTLE_LIMIT=30
# Swagger UI at /docs. Defaults to on outside production.
# SWAGGER_ENABLED=true

# --- Observability ----------------------------------------------------------------
# json (one object per line, for log collectors) or pretty. Default: json in production.
# LOG_FORMAT=pretty
# error | warn | log | debug | verbose  (debug also prints stubbed email bodies)
LOG_LEVEL=log
# Prometheus metrics at /metrics: on in development; in production only when METRICS_TOKEN
# (>= 16 chars, sent as `Authorization: Bearer`) is set, or METRICS_ENABLED=true is forced.
# METRICS_ENABLED=true
# METRICS_TOKEN=

# --- Tests --------------------------------------------------------------------
# e2e tests default to DATABASE_URL + "_test" and Redis db 15. Override if needed.
# TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app_test?schema=public
# TEST_REDIS_URL=redis://localhost:6379/15
